# ============================================================
# Strict code-only repository boundary
#
# The working directory intentionally keeps local CARE inputs, paper
# material, internal notes, and experiment outputs.  None of those belong
# in the repository created from this directory.
# ============================================================
publication/
tmp/
experiments/**/results/

